<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="verified_purchase_customer_order"
        resource="default"
        engine="innodb"
        comment="Verified Purchase Order Information">

        <column name="entity_id" xsi:type="int" unsigned="true" nullable="false" identity="true" comment="Primary" />
        <column name="order_id" xsi:type="int" unsigned="true" nullable="true" comment="Order" />
        <column name="increment_id" xsi:type="varchar" nullable="true" length="50" comment="Increment ID"/>
        <column name="is_completed" xsi:type="boolean" nullable="true" default="0" />
        <column name="is_failed" xsi:type="boolean" nullable="true" default="0" />
        <column name="failures_num" xsi:type="int" padding="3" unsigned="true" nullable="true"
                default="0" comment="Number of tries"/>

        <column name="customer_id" xsi:type="int" unsigned="true" nullable="true" comment="Customer ID" />
        <column name="buyer_email" xsi:type="varchar" nullable="true" length="128" comment="Customer Email"/>
        <column name="masked_credit_card" xsi:type="varchar" nullable="true" length="30" comment="Masked Credit Card"/>

        <column name="status" xsi:type="varchar" nullable="true" length="32" comment="Status"/>

        <column name="customer_identifier" xsi:type="varchar" nullable="true" length="128" comment=""/>
        <column name="verification_mode" xsi:type="varchar" nullable="true" length="20" comment=""/>
        <column name="time_amount" xsi:type="varchar" nullable="true" length="20" comment=""/>
        <column name="time_unit" xsi:type="varchar" nullable="true" length="20" comment=""/>

        <column name="verified_purchase_id" xsi:type="varchar" nullable="true" length="128" comment=""/>
        <column name="verification_channel" xsi:type="varchar" nullable="true" length="30" comment=""/>

        <column name="transaction_identifier" xsi:type="varchar" nullable="true" length="50" comment=""/>
        <column name="buyer_identifier" xsi:type="varchar" nullable="true" length="50" comment=""/>

        <column name="created_at" xsi:type="timestamp" on_update="false" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Created At"/>
        <column name="updated_at" xsi:type="timestamp" on_update="true" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Updated At"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>

        <constraint xsi:type="foreign" referenceId="VERIFIED_PURCHASE_ORDER_ID_SALES_ORDER_ENTITY_ID"
            table="verified_purchase_customer_order" column="order_id"
            referenceTable="sales_order" referenceColumn="entity_id"
            onDelete="CASCADE"/>

        <constraint xsi:type="foreign" referenceId="VERIFIED_PURCHASE_ORDER_CUSTOMER_ID_CUSTOMER_ENTITY_ENTITY_ID"
            table="verified_purchase_customer_order" column="customer_id"
            referenceTable="customer_entity" referenceColumn="entity_id"
            onDelete="SET NULL" />

        <index referenceId="VERIFIED_PURCHASE_ORDER_ID" indexType="btree">
            <column name="order_id" />
        </index>
        <index referenceId="VERIFIED_PURCHASE_CUSTOMER_ID" indexType="btree">
            <column name="customer_id" />
        </index>
        <index referenceId="VERIFIED_PURCHASE_EMAIL_MASKED_CARD" indexType="fulltext">
            <column name="buyer_email" />
            <column name="masked_credit_card" />
        </index>
    </table>
</schema>
